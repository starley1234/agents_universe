# Скопируйте в .env и заполните нужное.

# --- обязательное хранилище: PostgreSQL (метаданные, Bronze/Silver/Gold,
# карантин, MDM, аудит) ---
# Без этой переменной приложение отказывается стартовать (см. dataforge/config.py).
DB_DSN=postgresql://forge:forge@localhost:5432/dataforge

# --- MDM: пороги вероятностного матчинга (guardrail — численные, не "на глаз") ---
# score >= MATCH_AUTO_THRESHOLD        -> можно авто-слить в golden record
# MATCH_REVIEW_THRESHOLD <= score <    -> stewardship-очередь (решает человек)
#                          auto_threshold
MATCH_AUTO_THRESHOLD=0.92
MATCH_REVIEW_THRESHOLD=0.65

# --- Quality Engine ---
QUALITY_DEFAULT_SEVERITY=error   # error | warning

# --- интеграция с 1С через OData (см. README.md за честной границей
# объёма — реального сервера 1С в этой сборке нет, только протокольно-
# честная заглушка на fake-HTTP-сервере) ---
ONEC_BASE_URL=
ONEC_API_KEY=
ONEC_TIMEOUT=30

# --- HTTP API/дашборд ---
FORGE_HOST=127.0.0.1
FORGE_PORT=8200
FORGE_API_TOKEN=                # обязателен, если FORGE_HOST != 127.0.0.1
