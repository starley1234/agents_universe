# Скопируйте в .env и заполните. .env в git не коммитится.

# --- модель ---------------------------------------------------------------
# fake — оффлайн-заглушка, работает без ключей и без сети (по умолчанию)
VLM_PROVIDER=fake
# VLM_PROVIDER=openai
# VLM_MODEL=gpt-4o-mini
# VLM_API_KEY=sk-...
# VLM_BASE_URL=                  # для OpenAI-совместимых шлюзов
VLM_TEMPERATURE=0
VLM_MAX_TOKENS=2048

# --- изображения ----------------------------------------------------------
# Главный рычаг стоимости: провайдер берёт плату за пиксели.
# 1024 px по длинной стороне — разумный компромисс цены и детализации.
VLM_MAX_SIDE_PX=1024
VLM_MAX_UPLOAD_MB=20
VLM_MAX_IMAGES=8
VLM_JPEG_QUALITY=85

# --- эксплуатация ---------------------------------------------------------
VLM_DB=data/vlm.db
# Кеш по хешам изображений: тот же кадр не оплачивается дважды.
VLM_CACHE=1
VLM_CACHE_TTL_S=604800          # 7 суток
VLM_MAX_RETRIES=2               # повторы на 429 и сетевых сбоях
VLM_REQUEST_TIMEOUT_S=120
# Предохранитель от разорения: 0 — без лимита. Поставьте реальный потолок.
VLM_DAILY_BUDGET_USD=0

# --- сервис ---------------------------------------------------------------
# Без токена serve поднимется ТОЛЬКО на 127.0.0.1. Только ASCII.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
VLM_API_TOKEN=
VLM_HOST=127.0.0.1
VLM_PORT=8081
VLM_LOG=INFO
