# === APP SETTINGS ===
# By default C.O.R.T.E.X. auto-loads c_o_r_t_e_x/.env (or cwd/.env).
# Override the path at startup with: python -m c_o_r_t_e_x serve --env-file /path/.env
PROJECT_NAME="C.O.R.T.E.X."
ENVIRONMENT=development # development, staging, production
APP_HOST=0.0.0.0
APP_PORT=8117
APP_SECRET_KEY=generate-secure-key-here

# === LLM CONFIGURATION ===
LLM_ACTIVE_PROVIDER=custom_remote
CUSTOM_REMOTE_URL=https://my-lm-studio.example/api/v1
CUSTOM_REMOTE_KEY=sk-local
CUSTOM_REMOTE_MODEL=unsloth/gemma-4-12b-it
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-lite:preview

# === EMBEDDINGS ===
EMBEDDING_URL=https://my-lm-studio.example/api/v1
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_KEY=

# === DATABASE / EVENT BUS ===
DATABASE_URL=postgresql://user:pass@127.0.0.1:5433/dbname
CORTEX_EVENT_BUS=memory # memory, redis, nats
REDIS_URL=redis://127.0.0.1:6379/0
NATS_URL=nats://127.0.0.1:4222
TEMPORAL_TARGET=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
ORCHESTRATION_BACKEND=in_memory # in_memory, temporal, langgraph

# === OPTIONAL LLM OBSERVABILITY ===
LITELLM_API_URL=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
PHOENIX_ENDPOINT=

# === EMAIL / MESSENGERS ===
MAIL_SERVER=smtp.test.com
MAIL_PORT=465
MAIL_USERNAME=your-email@test.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=noreply@example.com
SMTP_USE_SSL=true
TELEGRAM_BOT_TOKEN=

# === MCP SERVERS ===
MCP_SEARCH_URL=http://127.0.0.1:8001/sse
MCP_AGENT_TOOLKIT=http://127.0.0.1:8090/sse
MCP_AGENT_TOOLKIT_KEY=

# === C.O.R.T.E.X. ===
CORTEX_TOOLKIT_MODE=auto # auto, local, remote, disabled
WORKSPACE_PATH=./workspace
CORTEX_AUDIT_NATIVE=true
CORTEX_AUDIT_ALLOW_NETWORK=false
CORTEX_AUDIT_ALLOW_SIDE_EFFECTS=true
CORTEX_FETCH_ALLOW_HOSTS= # comma-separated allowlist in production, e.g. docs.example.com
CORTEX_MAX_EVENT_HISTORY=2000
CORTEX_CORS_ORIGINS=*
LOG_LEVEL=INFO
