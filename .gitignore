## Виртуальные окружения Python — не индексируем, ставятся через
## python3 -m venv .venv && pip install -r ...
.venv/
venv/
env/
.env

## Байткод и кэши Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

## Рантайм-артефакты agent_system: база состояния (память/онтология/план)
## и рабочая папка агента по умолчанию — генерируются при запуске,
## в git не нужны.
agent_system/agent.db
agent_system/agent.db-*
agent_system/workspace/
*.db
*.db-journal
*.db-wal
*.db-shm

## Рантайм-артефакты multi_agent_system_ontology: MAOS требует внешний
## PostgreSQL и ничего не пишет на диск сам по себе, кроме случайных
## временных данных embedded Postgres при локальных экспериментах.
multi_agent_system_ontology/**/pgdata/
multi_agent_system_ontology/**/.pgserver/

## Рантайм-артефакты agentic_workflow_os: состояние среды (прогоны,
## доска контекста, точки контроля) в SQLite и рабочая папка агентов —
## создаются при запуске, в git не нужны. Определения workflow и
## профилей (awos/workflows, awos/profiles) — наоборот, часть поставки.
agentic_workflow_os/awos.db
agentic_workflow_os/awos.db-*
agentic_workflow_os/workspace/

## Прочий мусор ОС/редакторов
.DS_Store
*.swp

## Рантайм-артефакты saps: выгрузки протоколов и временные файлы.
## Схема живёт в PostgreSQL, на диск САПС пишет только отчёты.
saps/workdir/
saps/*.docx
saps/*.xlsx
