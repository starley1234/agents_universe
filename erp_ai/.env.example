# Скопируйте в .env и заполните нужное.

# --- обязательное хранилище: PostgreSQL ---
# Без этой переменной приложение отказывается стартовать (см. app/config.py).
DB_DSN=postgresql://erp:erp@localhost:5432/erp_ai

# --- guardrails агента-снабженца ---
# Сумма заказа выше этого порога НИКОГДА не проводится автоматически
# (auto_with_review/full_auto принудительно понижаются до draft).
PROCUREMENT_MAX_AUTO_AMOUNT=50000
PROCUREMENT_DEFAULT_AUTONOMY=draft   # suggest | draft | auto_with_review | full_auto

# --- интеграция с 1С (EnterpriseData-подобный протокол, см. README.md
# за честной границей объёма — реального сервера 1С в этой сборке нет) ---
ONEC_BASE_URL=
ONEC_API_KEY=
ONEC_TIMEOUT=30
ONEC_MASTER_COUNTERPARTY=erp     # erp | 1c — чьи данные побеждают при конфликте
ONEC_MASTER_NOMENCLATURE=erp     # erp | 1c

# --- опциональный LLM для более естественных объяснений агента ---
# Без настройки используется детерминированный текст (не хуже, только
# менее "гладкий") — агент никогда не зависит от LLM для базовой работы.
ERP_LLM_BASE_URL=
ERP_LLM_API_KEY=
ERP_LLM_MODEL=
ERP_LLM_TIMEOUT=30

# --- HTTP API/дашборд ---
ERP_HOST=127.0.0.1
ERP_PORT=8100
ERP_API_TOKEN=                  # обязателен, если ERP_HOST != 127.0.0.1
