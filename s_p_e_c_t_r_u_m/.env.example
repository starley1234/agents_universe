# === APP SETTINGS ===
PROJECT_NAME=SPECTRUM
APP_PORT=8118
WORKSPACE_DIR=./knowledge_base
LOG_LEVEL=INFO

# === PROCESSING ===
CHUNK_SIZE=1024
CHUNK_OVERLAP=200
USE_VLM=false
MAX_FILE_SIZE_MB=100

# === LLM CONFIGURATION ===
# Выбираем активный профиль: openrouter, custom_remote, ollama, fake
LLM_ACTIVE_PROVIDER=fake

# --- Profile: Custom Remote (LM Studio / vLLM / TGI) ---
CUSTOM_REMOTE_URL=http://localhost:1234/v1
CUSTOM_REMOTE_KEY=sk-local
CUSTOM_REMOTE_MODEL=unsloth/gemma-4-12b-it

# --- Profile: OpenRouter ---
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=google/gemini-2.0-flash-lite:preview

# --- Profile: Ollama ---
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_KEY=ollama
OLLAMA_MODEL=llama3

# === VECTOR DB ===
# chroma (встроенный, без Docker) или qdrant (Docker)
VECTOR_STORE=chroma
QDRANT_HOST=localhost
QDRANT_PORT=6333
CHROMA_PERSIST_DIR=data/chroma
COLLECTION_NAME=spectrum

# === OCR ===
OCR_ENGINE=tesseract
TESSERACT_LANG=rus+eng

# === TASK QUEUE (Redis) ===
REDIS_URL=redis://localhost:6379

# === SCRAPING ===
PLAYWRIGHT_TIMEOUT=30000
