# Скопируйте в .env и заполните. Секреты (пароль Teamcenter, ключи API,
# токен доступа) живут ТОЛЬКО здесь: JSON-конфиг их демонстративно
# игнорирует — пароль от промышленного PDM в репозитории это инцидент.
#
#   export $(grep -v '^#' .env | xargs)

# --- ХРАНИЛИЩЕ: обязательно (Database-First, ТЗ п.2.3) ---
# Без этой переменной САПС не стартует. Нужен PostgreSQL 14+ с pgvector:
#   CREATE EXTENSION vector;
SAPS_DB_DSN=postgresql://saps:saps@localhost:5432/saps
SAPS_DB_SCHEMA=saps

# --- TEAMCENTER (ТЗ п.3.1, режим А) ---
SAPS_TC_URL=http://org-tc2:8080/tc
SAPS_TC_USER=
SAPS_TC_PASSWORD=
SAPS_TC_GROUP=
SAPS_TC_ROLE=
SAPS_TC_TIMEOUT=60
# Обратная запись в промышленный PDM. Выключена намеренно: включать
# должен человек осознанно. Даже включённая, она пишет только требования
# со статусом approved и без висящих предложений агентов.
SAPS_TC_WRITE=false

# --- LLM для агентского слоя (ТЗ п.3.2) ---
# none        — агенты работают на детерминированных правилах (по умолчанию);
# openai_like — любой OpenAI-совместимый /v1: OpenAI, OpenRouter,
#               LM Studio, llama.cpp server, vLLM, Ollama в режиме /v1.
SAPS_LLM_PROVIDER=none
SAPS_LLM_MODEL=gpt-4o-mini
SAPS_LLM_BASE_URL=https://api.openai.com/v1
SAPS_LLM_API_KEY=
# 0 — воспроизводимость: один и тот же разбор требования обязан давать
# один и тот же результат, иначе его нечем объяснить регулятору.
SAPS_LLM_TEMPERATURE=0.0
SAPS_LLM_TIMEOUT=120

# Пример: локальная модель в закрытом контуре
# SAPS_LLM_PROVIDER=openai_like
# SAPS_LLM_BASE_URL=http://localhost:1234/v1
# SAPS_LLM_MODEL=qwen2.5-14b-instruct

# --- ЭМБЕДДИНГИ (семантический поиск по требованиям и пунктам АП) ---
# hash  — офлайн, без сети и ключей. Сравнивает СЛОВА, а не смысл:
#         синонимы не понимает. Годится для дедупликации и демо.
# local — сервер с /v1/embeddings (LM Studio и т.п.) — нужен для
#         честного подбора пунктов АП по смыслу.
SAPS_EMBEDDING_PROVIDER=hash
SAPS_EMBEDDING_MODEL=hash-512
# ВАЖНО: размерность фиксируется в схеме БД (vector(dim)) при первом
# init и не меняется на лету. Задайте её под свою модель ДО init
# (у nomic-embed-text — 768, у text-embedding-3-small — 1536).
SAPS_EMBEDDING_DIM=512
SAPS_EMBEDDING_BASE_URL=
SAPS_EMBEDDING_API_KEY=
SAPS_EMBEDDING_TIMEOUT=60

# --- ПОРОГИ ---
# Ниже этой оценки формулировка считается проблемной.
SAPS_QUALITY_MIN=0.7
# Порог уверенности классификатора для СЕМАНТИЧЕСКИХ эмбеддингов.
SAPS_CLASSIFY_MIN=0.55
# Порог для офлайн-эмбеддера hash: у мешка слов косинус физически ниже,
# верное попадание там 0.25–0.45. Один порог на две шкалы означал бы,
# что на hash классификатор молчит всегда.
SAPS_CLASSIFY_MIN_HASH=0.22
SAPS_CLASSIFY_TOP_K=5

# --- ВЕБ-ИНТЕРФЕЙС И API ---
SAPS_HOST=127.0.0.1
SAPS_PORT=8090
# Обязателен, если SAPS_HOST != 127.0.0.1: система отдаёт данные
# сертификации и умеет писать в Teamcenter.
SAPS_API_TOKEN=

# --- РАБОЧИЙ КАТАЛОГ (выгрузки) ---
SAPS_WORKDIR=workdir
