# Что НЕ должно попасть в образ.
#
# Дело не только в размере: .git содержит всю историю (в ней могли
# оказаться тестовые пароли), а .env — реальные секреты контура.
# Образ с ними уедет в реестр и станет доступен всем, у кого есть доступ
# к реестру.

# --- секреты и локальные настройки ---
.env
*.env
!.env.example

# --- история и служебное ---
.git
.gitignore
.gitattributes

# --- то, что не нужно в рантайме ---
tests/
tools/
ARCHITECTURE.md

# --- артефакты ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# --- рабочие данные: в контейнере это том /data ---
workdir/
inbox/
*.dump
*.docx
*.xlsx
*.db
