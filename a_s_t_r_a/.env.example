# === APP SETTINGS ===
PROJECT_NAME="A.S.T.R.A."
ENVIRONMENT=development          # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8101
APP_SECRET_KEY=generate-secure-key-here

# === LLM PROVIDERS ===
LLM_DEFAULT_PROVIDER=local       # local | openrouter

# OpenRouter
OPENROUTER_LLM_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-lite:preview
OPENROUTER_API_KEY=sk-or-...

# Local LLM (LM Studio / Ollama / vLLM)
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=unsloth/gemma-4-12b-it
LOCAL_LLM_API_KEY=sk-local

# === EMBEDDINGS ===
EMBEDDING_URL=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_KEY=sk-local

# === DATABASE ===
DATABASE_URL=postgresql+asyncpg://astra:astra@localhost:5432/astra

# === EMAIL (SMTP) ===
MAIL_SERVER=smtp.test.com
MAIL_PORT=465
MAIL_USERNAME=your-email@test.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=noreply@example.com
SMTP_USE_SSL=true

# === MESSENGERS ===
TELEGRAM_BOT_TOKEN=

# === MCP SERVERS (Model Context Protocol) ===
MCP_SEARCH_URL=http://localhost:8001/sse
# MCP_IMAGE_GEN_URL=http://localhost:8002/sse
# MCP_TTS_URL=http://localhost:8003/sse

# === WORKSPACE ===
WORKSPACE_PATH=./workspace
