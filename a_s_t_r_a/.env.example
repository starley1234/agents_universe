# === APP SETTINGS ===
PROJECT_NAME="A.S.T.R.A."
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8101
APP_SECRET_KEY=change-me-in-prod
LOG_LEVEL=INFO

# === LLM PROVIDERS ===
# mock = тесты без реального LLM, local = LM Studio / Ollama / vLLM на OpenAI-совместимом API, openrouter = OpenRouter
LLM_DEFAULT_PROVIDER=mock

# OpenRouter
OPENROUTER_LLM_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-lite:preview
# Для OpenRouter модель в коде автоматически станет openrouter/<model> для LiteLLM
OPENROUTER_API_KEY=sk-or-...

# Local LLM (LM Studio / Ollama / vLLM) — OpenAI совместимый API
# ВАЖНО для Docker: внутри контейнера localhost = сам контейнер, поэтому для LMStudio на хосте используйте host.docker.internal
# Пример для локального запуска (без Docker): http://localhost:1234/v1
# Пример для Docker: http://host.docker.internal:1234/v1
LOCAL_LLM_URL=http://host.docker.internal:1234/v1
LOCAL_LLM_MODEL=unsloth/gemma-4-12b-it
# В коде модель автоматически нормализуется в openai/<model> для LiteLLM, поэтому unsloth/gemma-4-12b-it станет openai/unsloth/gemma-4-12b-it
LOCAL_LLM_API_KEY=sk-local

# === EMBEDDINGS ===
# Тоже OpenAI совместимый. Для Docker используйте host.docker.internal если LMStudio на хосте
EMBEDDING_URL=http://host.docker.internal:1234/v1
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_KEY=sk-local

# === DATABASE — Postgres + pgvector ===
DATABASE_URL=postgresql+asyncpg://astra:astra@postgres:5432/astra
# Для локального запуска без Docker:
# DATABASE_URL=postgresql+asyncpg://astra:astra@localhost:5432/astra

# Redis for TaskIQ
REDIS_URL=redis://localhost:6379/0
# В Docker: redis://redis:6379/0

# === GRAPH DB — FalkorDB for large graphs ===
USE_FALKORDB=false
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
# Для локального запуска без Docker: localhost:6380 если проброшен порт

# === JWT AUTH ===
AUTH_ENABLED=false
JWT_SECRET_KEY=super-secret-jwt-change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# === LANGFUSE TRACING ===
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# === EMAIL ===
MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
SMTP_USE_SSL=true

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=

# === MCP SERVERS ===
MCP_SEARCH_URL=http://localhost:8001/sse

# === WORKSPACE ===
WORKSPACE_PATH=./workspace
