# Скопируйте в .env и заполните нужное. Секреты живут ТОЛЬКО здесь:
# JSON-конфиг среды их демонстративно игнорирует (см. awos/config.py).
#
# Загрузить в текущую оболочку:
#   export $(grep -v '^#' .env | xargs)

# --- хранилище состояния и рабочая папка ---
# SQLite: одна база на всю среду. Состояние обязано пережить перезапуск
# процесса — иначе пауза на человеке не имеет смысла.
AWOS_DB=awos.db
AWOS_WORKSPACE=workspace

# --- модель по умолчанию (профиль агента может её перебить) ---
# openai_like — любой OpenAI-совместимый /v1: OpenAI, OpenRouter,
# LM Studio, llama.cpp server, vLLM, Ollama в режиме /v1.
# stub — детерминированный офлайн-провайдер (демо, CI, отладка workflow).
AWOS_PROVIDER=openai_like
AWOS_MODEL=gpt-4o-mini
AWOS_BASE_URL=https://api.openai.com/v1
AWOS_API_KEY=
AWOS_TEMPERATURE=0.2
AWOS_TIMEOUT=120
AWOS_LLM_RETRIES=2

# Пример: локальная модель в LM Studio (ключ обычно не нужен)
# AWOS_BASE_URL=http://localhost:1234/v1
# AWOS_MODEL=qwen2.5-14b-instruct
#
# Пример: OpenRouter
# AWOS_BASE_URL=https://openrouter.ai/api/v1
# AWOS_MODEL=anthropic/claude-3.5-sonnet

# --- цикл качества (Исполнитель -> Критик -> Контролёр) ---
# Сколько раз Исполнитель может переделать работу после замечаний.
AWOS_MAX_REVISIONS=2
# Порог оценки Критика [0..1], ниже которого работа возвращается.
AWOS_MIN_SCORE=0.7
# Максимум обращений к инструментам за один ход Исполнителя.
AWOS_MAX_TOOL_STEPS=8
AWOS_TOOL_OUTPUT_LIMIT=4000

# --- Human-in-the-Loop ---
# off      — среда не спрашивает человека никогда;
# critical — зовёт там, где сама сомневается (качество не вытянуло,
#            опасный инструмент, шаг с human=always/on_reject);
# always   — утверждение результата каждого шага.
AWOS_HITL=critical
# Сколько секунд синхронный запуск ждёт ответа человека, прежде чем
# уснуть в базе. 0 — не ждать (прогон сразу переходит в waiting_human и
# продолжается позже командой resume); отрицательное — ждать вечно.
AWOS_HITL_WAIT=0

# --- инструменты: гранты СРЕДЫ ---
# Профиль агента может только СУЗИТЬ этот набор, расширить — никогда.
# Белый список хостов для http_request. Пусто = HTTP запрещён.
AWOS_HTTP_ALLOW=
AWOS_HTTP_TIMEOUT=30
# Базы для sql_query (только чтение): alias=путь,alias2=путь
AWOS_SQL_DATABASES=
# shell выключен по умолчанию: это единственный инструмент, способный
# сделать с машиной что угодно. Включённый, он при AWOS_HITL!=off
# требует подтверждения человека ПЕРЕД каждым вызовом.
AWOS_ALLOW_SHELL=false
AWOS_SHELL_TIMEOUT=60

# --- HTTP API и веб-консоль ---
AWOS_HOST=127.0.0.1
AWOS_PORT=8070
# Обязателен, если AWOS_HOST != 127.0.0.1: среда исполняет текст модели
# и вызывает инструменты, открытый порт без токена = отданная машина.
AWOS_API_TOKEN=

# --- каталоги определений (пусто = встроенные в пакет) ---
AWOS_WORKFLOWS_DIR=
AWOS_PROFILES_DIR=
