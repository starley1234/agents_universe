# Copy to .env; never commit the filled file.
POSTGRES_DB=maos
POSTGRES_USER=maos
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
MAOS_PUBLIC_PORT=8090
# Required when the API is exposed through a reverse proxy or public network.
MAOS_API_TOKEN=GENERATE_A_SECOND_LONG_RANDOM_TOKEN
# Configure LLM, MCP, SMTP and MAX below or retain relevant values from .env.example.
DEFAULT_LOCAL_MODEL=local::llama3
DEFAULT_CLOUD_MODEL=openrouter::openai/gpt-4o-mini
OPENROUTER_API_KEY=
MAOS_CONFIRM_SENDS=true
