# Скопируйте в .env и заполните нужное.

# --- обязательное хранилище: PostgreSQL + pgvector ---
# Без этой переменной приложение отказывается стартовать (см. maos/config.py).
DB_DSN=postgresql://maos:maos@localhost:5432/maos

# --- гибридный LLM-роутинг: provider::model ---
DEFAULT_LOCAL_MODEL=local::llama3
DEFAULT_CLOUD_MODEL=openrouter::openai/gpt-4o-mini

# --- ключи провайдеров (в JSON-конфиг НЕ кладём, только сюда) ---
LOCAL_BASE_URL=http://localhost:11434/v1     # llama.cpp/vLLM/LM Studio/Ollama /v1
LOCAL_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- эмбеддинги (mid-term векторная память, semantic router) ---
# hash — локальный офлайн-эмбеддер без сети и ключа (по умолчанию, работает
# всегда, но не понимает синонимы); openai — облачный API; local/lmstudio —
# ЛЮБОЙ OpenAI-совместимый сервер с /v1/embeddings (LM Studio, vLLM,
# llama.cpp server, Ollama в режиме /v1).
MAOS_EMBEDDING_PROVIDER=hash
MAOS_EMBEDDING_MODEL=hash-256
MAOS_EMBEDDING_DIM=256
# Если модель эмбеддингов развёрнута на ВНЕШНЕМ сервере (например, LM
# Studio на другой машине в сети) — укажите его адрес и, если нужен,
# ключ здесь. Это ПЕРЕБИВАЕТ умолчания провайдера (LOCAL_BASE_URL выше)
# специально для эмбеддингов — диалоговая модель и модель эмбеддингов
# нередко крутятся на разных серверах/машинах.
# Пример для LM Studio: MAOS_EMBEDDING_PROVIDER=lmstudio,
# MAOS_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5,
# MAOS_EMBEDDING_BASE_URL=http://192.168.1.50:1234/v1
MAOS_EMBEDDING_BASE_URL=
MAOS_EMBEDDING_API_KEY=
MAOS_EMBEDDING_TIMEOUT=60

# --- трёхуровневая память и Graph-RAG ---
# Настройки контекстного окна и векторного/графового поиска в памяти.
MAOS_SMALL_CONTEXT_WINDOW=4096
MAOS_SHORT_TERM_KEEP_LAST=6
MAOS_MID_TERM_TOP_K=5
MAOS_MID_TERM_MIN_SCORE=0.15
MAOS_LONG_TERM_TOP_K=3
MAOS_LONG_TERM_MIN_SCORE=0.10
MAOS_LONG_TERM_MAX_HOPS=2

# --- фоновое обслуживание ("Deep Thinking") ---
MAOS_MAINTENANCE_INTERVAL_SECONDS=300
MAOS_MAINTENANCE_DISTILL_AFTER_MESSAGES=20
MAOS_MAINTENANCE_DEDUP_SIMILARITY=0.97
MAOS_MAINTENANCE_EXTRACT_ENTITIES=true

# --- TTS: реальный клиент OmniVoice (см. maos/tts/provider.py) ---
TTS_PROVIDER=none               # none | omnivoice | openai | elevenlabs | piper
TTS_DEFAULT_VOICE=
# Адрес и ключ сервера OmniVoice (или совместимого) — обязателен для
# provider=omnivoice. Голос конкретного агента задаётся отдельно полем
# voice_id в его профиле (POST /v1/agents).
TTS_BASE_URL=
TTS_API_KEY=
TTS_AUDIO_FORMAT=mp3            # mp3 | wav | ogg | opus | flac
TTS_TIMEOUT=60

# --- мультимодальность: анализ изображений (Vision) ---
# Настройки для инструмента analyze_image (навык "vision").
MAOS_VISION_BASE_URL=https://openrouter.ai/api/v1
MAOS_VISION_API_KEY=
MAOS_VISION_MODEL=openai/gpt-4o-mini
MAOS_VISION_TIMEOUT=60

# --- рабочие папки и инструменты MAOS-агентов (опционально) ---
# Агент с непустым agent.tools ("files,web,office,rag") получает
# инструментальный цикл; files/office работают в своей подпапке
# workspace_root/<slug>, изолированной от остальных агентов.
MAOS_WORKSPACE_ROOT=./workspace
# Артефакты задач хранятся отдельно от временных agent workspace.
MAOS_ARTIFACT_ROOT=./artifacts
MAOS_ARTIFACT_UPLOAD_MAX_BYTES=20000000
# Навык "web": поиск через DuckDuckGo (без ключа) или собственный SearXNG.
MAOS_WEB_SEARCH_BASE_URL=       # обязателен только для backend=searxng

# --- HTTP API/дашборд ---
MAOS_HOST=127.0.0.1
MAOS_PORT=8090
MAOS_API_TOKEN=                 # обязателен, если MAOS_HOST != 127.0.0.1

# --- внешние MCP-серверы ---
# JSON-объект (можно многострочно через export, но в .env удобнее одной
# строкой). Поддерживается формат LM Studio: {"mcpServers": {...}}.
# ВАЖНО: токены в headers держите здесь, .env игнорируется Git.
# URL /sse обычно означает классический SSE-транспорт MCP; URL /mcp —
# Streamable HTTP. Укажите transport соответственно.
MAOS_MCP_SERVERS={"mcpServers":{"web_search":{"transport":"http","url":"http://111.222.333.44:8001/sse/","rate_limit":1,"timeout":60},"img_toolforge":{"transport":"http","url":"https://img.toolforge.ru/sse","rate_limit":1,"timeout":120}}}

# --- отправка уведомлений и файлов: навык messaging ---
# Включите агента с tools: "files,web,mcp,messaging". Почтовые секреты
# находятся только в .env, а не в JSON-конфигурации. Для 465 задайте
# SMTP_USE_SSL=true и SMTP_STARTTLS=false; для 587 обычно наоборот.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDR=              # пусто -> SMTP_USER
SMTP_USE_SSL=false
SMTP_STARTTLS=true
# Защита от самовольной внешней отправки: по умолчанию true, поэтому
# email_send/max_send_message откажутся без UI-подтверждения. Для
# доверенного полностью автоматического workflow установите false.
MAOS_CONFIRM_SENDS=true

# MAX Bot API. Сейчас доступны текстовые уведомления; токен только здесь.
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
