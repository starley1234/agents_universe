# Скопируйте в .env и заполните нужное.

# --- обязательное хранилище: PostgreSQL + pgvector ---
# Без этой переменной приложение отказывается стартовать (см. maos/config.py).
DB_DSN=postgresql://maos:maos@localhost:5432/maos

# --- гибридный LLM-роутинг: provider::model ---
DEFAULT_LOCAL_MODEL=local::llama3
DEFAULT_CLOUD_MODEL=openrouter::openai/gpt-4o-mini

# --- ключи провайдеров (в JSON-конфиг НЕ кладём, только сюда) ---
LOCAL_BASE_URL=http://localhost:11434/v1     # llama.cpp/vLLM/LM Studio/Ollama /v1
LOCAL_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- эмбеддинги (mid-term векторная память, semantic router) ---
# hash — локальный офлайн-эмбеддер без сети и ключа (по умолчанию, работает
# всегда, но не понимает синонимы); openai — облачный API; local/lmstudio —
# ЛЮБОЙ OpenAI-совместимый сервер с /v1/embeddings (LM Studio, vLLM,
# llama.cpp server, Ollama в режиме /v1).
MAOS_EMBEDDING_PROVIDER=hash
MAOS_EMBEDDING_MODEL=hash-256
MAOS_EMBEDDING_DIM=256
# Если модель эмбеддингов развёрнута на ВНЕШНЕМ сервере (например, LM
# Studio на другой машине в сети) — укажите его адрес и, если нужен,
# ключ здесь. Это ПЕРЕБИВАЕТ умолчания провайдера (LOCAL_BASE_URL выше)
# специально для эмбеддингов — диалоговая модель и модель эмбеддингов
# нередко крутятся на разных серверах/машинах.
# Пример для LM Studio: MAOS_EMBEDDING_PROVIDER=lmstudio,
# MAOS_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5,
# MAOS_EMBEDDING_BASE_URL=http://192.168.1.50:1234/v1
MAOS_EMBEDDING_BASE_URL=
MAOS_EMBEDDING_API_KEY=
MAOS_EMBEDDING_TIMEOUT=60

# --- TTS (интерфейс провайдера, см. maos/tts/provider.py) ---
# Синтез речи НЕ реализован в этой сборке — параметр зарезервирован.
TTS_PROVIDER=none
TTS_DEFAULT_VOICE=

# --- HTTP API/дашборд ---
MAOS_HOST=127.0.0.1
MAOS_PORT=8090
MAOS_API_TOKEN=                 # обязателен, если MAOS_HOST != 127.0.0.1
