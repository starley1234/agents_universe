# Песочница для выполнения команд агента.
# Одноразовый контейнер: сеть выключена, наружу видна только рабочая папка.
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash coreutils findutils grep sed gawk \
        python3 python3-pip \
        git make build-essential \
        openscad xvfb \
    && rm -rf /var/lib/apt/lists/*

# Пользователь создаётся на лету через -u, поэтому просто готовим точку входа
WORKDIR /work
CMD ["bash"]
