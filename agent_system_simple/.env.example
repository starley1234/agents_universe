# Скопируйте в .env и заполните нужное.
# Секреты живут ТОЛЬКО здесь: конфиг кладётся в git, .env — нет.

# ─── выбор модели ─────────────────────────────────────────────
AGENT_PROVIDER=ollama          # openai | anthropic | ollama | openrouter | vllm | lmstudio
AGENT_MODEL=devstral-small-2:22b
# AGENT_PROFILE=coder          # роль по умолчанию
# AGENT_WORKSPACE=./workspace

# ─── ключи моделей ────────────────────────────────────────────
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# ─── поведение ────────────────────────────────────────────────
AGENT_SANDBOX=auto             # auto | docker | confirm | off
                               # auto: docker если есть, иначе confirm

# ─── HTTP API и веб-интерфейс ─────────────────────────────────
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
AGENT_API_TOKEN=               # обязателен, если host != 127.0.0.1
                               # только латиница: HTTP-заголовки
                               # не принимают кириллицу

# ─── связь с внешним миром (навык comms) ──────────────────────
# Кому разрешено писать — в конфиге, ключ comms.allow_to.
# Пустой список = никому, всё уходит в черновики outbox/
AGENT_SMTP_PASS=               # пароль почтового ящика
AGENT_IMAP_PASS=               # если отличается от SMTP
AGENT_TG_TOKEN=                # Telegram
AGENT_MAX_TOKEN=               # мессенджер MAX
