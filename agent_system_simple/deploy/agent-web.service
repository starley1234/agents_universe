# Веб-интерфейс и HTTP API.
# Наружу без AGENT_API_TOKEN сервер не поднимется — так задумано.

[Unit]
Description=Agent web — интерфейс и API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/agent_system
EnvironmentFile=-/opt/agent_system/.env
ExecStart=/usr/bin/python3 -m agent.server
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-web

MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
