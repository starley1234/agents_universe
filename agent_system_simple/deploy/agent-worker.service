# Фоновый исполнитель: берёт задания из очереди и доводит до конца.
# Именно он делает возможным «поставил и забыл».
#
#   sudo cp deploy/*.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now agent-worker agent-web
#   journalctl -u agent-worker -f

[Unit]
Description=Agent worker — фоновое выполнение заданий
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/agent_system
EnvironmentFile=-/opt/agent_system/.env
ExecStart=/usr/bin/python3 -m agent.worker --quiet
Restart=always
RestartSec=5

# Логи в journald; ротацию делает сам journald, отдельный файл не нужен.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-worker

# Работа идёт часами: не даём одному заданию съесть весь сервер.
# 1 ГБ на машине — половина исполнителю, остальное системе и docker.
MemoryMax=512M
CPUQuota=150%

# Агент правит файлы только в своей рабочей папке.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
