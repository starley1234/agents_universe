# Скопируйте в .env и заполните. Файл .env в git не коммитится.

# --- модель ---------------------------------------------------------------
# fake — оффлайн-заглушка, работает без ключей (по умолчанию)
ACONSTRUCTOR_PROVIDER=fake
# ACONSTRUCTOR_PROVIDER=openai
# ACONSTRUCTOR_MODEL=gpt-4o-mini
# ACONSTRUCTOR_API_KEY=sk-...
# ACONSTRUCTOR_BASE_URL=            # для совместимых с OpenAI шлюзов
ACONSTRUCTOR_TEMPERATURE=0
ACONSTRUCTOR_MAX_TOKENS=2048

# --- сервис ---------------------------------------------------------------
# Без токена serve поднимется ТОЛЬКО на 127.0.0.1. Для публикации обязателен.
# Только ASCII: токен уходит в HTTP-заголовок.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
ACONSTRUCTOR_API_TOKEN=

ACONSTRUCTOR_HOST=127.0.0.1
ACONSTRUCTOR_PORT=8080
ACONSTRUCTOR_WORKERS=2
ACONSTRUCTOR_TIMEOUT=600
ACONSTRUCTOR_LOG=INFO

# --- данные ---------------------------------------------------------------
ACONSTRUCTOR_DB=data/aconstructor.db
