# Скопируйте в .env и заполните нужное.

# --- выбор модели ---
AGENT_PROVIDER=openai          # openai | anthropic | ollama | openrouter | vllm | ...
AGENT_MODEL=gpt-4o-mini

# --- ключи (в конфиг НЕ кладём, только сюда) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- поведение ---
AGENT_SANDBOX=auto             # auto | docker | confirm | off
                               # auto: docker если есть, иначе confirm
AGENT_WORKSPACE=./workspace

# --- HTTP API ---
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
AGENT_API_TOKEN=               # обязателен, если host != 127.0.0.1

# --- навык "pdf": отдельная vision-модель для распознавания страниц ---
# Если не заданы — используется AGENT_PROVIDER/AGENT_MODEL выше.
AGENT_VISION_PROVIDER=
AGENT_VISION_MODEL=

# --- навыки "rag"/"pg_ontology": эмбеддинги ---
# Если не заданы — используется AGENT_PROVIDER выше с моделью embedding_model
# из конфига (по умолчанию text-embedding-3-small). "hash" — локальный
# офлайн-эмбеддер без сети и ключа (хуже по семантике, но работает всегда).
AGENT_EMBEDDING_PROVIDER=
AGENT_EMBEDDING_MODEL=

# --- навык "pg_ontology": PostgreSQL + pgvector ---
AGENT_PG_DSN=                  # postgresql://user:pass@host:5432/db

# --- навык "messaging": email (SMTP/IMAP) ---
# Остальные поля (порт, TLS-режим, адрес "от") задаются в JSON-конфиге
# в секции "messaging.email" — здесь только секреты.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# --- навык "messaging": Telegram Bot API ---
# Получить токен: @BotFather в Telegram, команда /newbot
TELEGRAM_BOT_TOKEN=

# --- навык "messaging": MAX Bot API (dev.max.ru) ---
# Получить токен: бот "MAX для бизнеса" в приложении MAX, команда
# «Получить токен» (нужен верифицированный профиль)
MAX_BOT_TOKEN=
